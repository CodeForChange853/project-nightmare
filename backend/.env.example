# Copy to backend/.env and edit.

# Required. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
NIGHTMARE_TOKEN=

# The one folder Nightmare may look inside. Leave empty to auto-detect Desktop
# (also tries OneDrive\Desktop). Set it explicitly if yours is elsewhere.
DESKTOP_ROOT=

# Which handoff file to read inside each project (searched up to 2 folders deep).
HANDOFF_FILENAME=handoff.md
HANDOFF_MAX_CHARS=12000

# Antigravity CLI. AGY_FORMAT: auto | json | text (run scripts/agy_smoke_test.py to pick).
AGY_COMMAND=agy
AGY_TIMEOUT=90
AGY_FORMAT=auto
AGY_FAST_MODEL=gemini-3.8-flash-low
AGY_SMART_MODEL=gemini-3.8-flash-high
LLM_ENABLED=1
# activity-log rows older than this are deleted at startup (0 = keep forever)
LOG_RETENTION_DAYS=90

# Allow "run command <anything>" (always asks for a click first). Leave off unless you need it.
ALLOW_RAW_COMMANDS=0

# Browser pages allowed to call the API (your Vite dev server).
NIGHTMARE_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NIGHTMARE_PORT=8000

# PIN login for built single-server mode (and read-only phone PIN for remote mode).
# Laptop PIN grants full access; Phone PIN grants read-only access (progress, list, chat).
NIGHTMARE_PIN=
NIGHTMARE_PHONE_PIN=

# Phone access over Tailscale (Phase 4). Your laptop's tailnet name, e.g. laptop.tail1234.ts.net.
# scripts/setup_tailscale.ps1 fills this in. Empty = remote access refused. Anything that arrives
# through tailscale serve is read-only, whichever PIN is typed.
NIGHTMARE_ALLOWED_HOSTS=

# Shortcut that opens/hides the small always-on-top Nightmare window (backend\hotkey.py).
# Needs Ctrl, Alt or Win plus a key, e.g. ctrl+alt+n, win+shift+f9. "off" turns the helper off.
NIGHTMARE_HOTKEY=ctrl+alt+n

# Weather default city (uses wttr.in by default with no key, or OpenWeather if key is set).
WEATHER_CITY=Calbayog
OPENWEATHER_API_KEY=
